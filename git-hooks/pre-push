#!/bin/bash
# Git pre-push hook for Elixir LiveView surfaces
# Enforces proof-of-validation (test → compile → credo → proof file)
# Then builds and publishes release to GitHub

set -e

echo "🔍 Running pre-push checks..."
echo ""

# Check if we're pushing to main
read local_ref local_oid remote_ref remote_oid
if [[ $remote_ref == "refs/heads/main" ]]; then
  echo "⚠️  Pushing to main branch - enforcing proof-of-validation..."
  echo ""

  # Check for proof-of-validation
  if [ ! -f .push-validated ]; then
    echo "❌ No proof-of-validation (.push-validated) found"
    echo "   Run: make push"
    echo "   This will validate code (test → compile → credo) and create proof"
    exit 1
  fi

  # Check proof is recent (within 5 minutes)
  PROOF_TIME=$(stat -f %m .push-validated 2>/dev/null || stat -c %Y .push-validated 2>/dev/null)
  NOW=$(date +%s)
  AGE=$((NOW - PROOF_TIME))
  MAX_AGE=300  # 5 minutes

  if [ $AGE -gt $MAX_AGE ]; then
    echo "❌ Proof-of-validation is stale (${AGE}s old, max ${MAX_AGE}s)"
    echo "   Run: make push"
    exit 1
  fi

  echo "✓ Proof-of-validation found and valid"
  echo ""

  echo "📦 Building OTP release..."
  MIX_ENV=prod mix release --overwrite || {
    echo "❌ Release build failed - push aborted"
    exit 1
  }

  # Now that the build is done, the release directory should hold the version we
  # just built and nothing else. `mix release --overwrite` rewrites the current
  # version but never removes older ones, so without this every past version
  # rides along and the tarball below grows without bound.
  #
  # Order matters: run this BEFORE the tar and AFTER the build. Before the build
  # it would keep the version being replaced, the build would add the new one,
  # and the artifact would carry two copies — the assertion below would fail on
  # every version bump.
  echo ""
  echo "🧹 Pruning stale release artifacts (so this build ships one app copy, not every past one)..."
  ./scripts/prune_release_artifacts.sh --build-tree --apply || \
    echo "⚠️  build-tree prune skipped — the assertion below will catch a stale artifact"

  echo ""
  echo "🚀 Publishing release to GitHub..."
  RELEASE_NAME=$(grep 'app:' mix.exs | head -1 | sed -E 's/.*app: :([^,]+).*/\1/')
  # One _build can hold more than one app's release — a sibling surface, or a
  # tree seeded from another repo. A glob over both reads both start_erl.data
  # files, which is how `sre_runbooks_liveview-0.1.015.2.7.5.tar.gz` got its
  # name: two versions concatenated into one filename. Pick the directory that
  # holds THIS app's code, and refuse to guess if that is still ambiguous.
  RELEASE_DIR=""
  for d in _build/prod/rel/*/; do
    ls "${d}lib/$RELEASE_NAME"-[0-9]* >/dev/null 2>&1 || continue
    if [ -n "$RELEASE_DIR" ]; then
      echo "❌ two release directories hold $RELEASE_NAME (${RELEASE_DIR}, ${d%/}) — refusing to publish"
      exit 1
    fi
    RELEASE_DIR="${d%/}"
  done
  if [ -z "$RELEASE_DIR" ]; then
    echo "❌ no release directory under _build/prod/rel holds $RELEASE_NAME"
    exit 1
  fi
  RELEASE_DIR_NAME=$(basename "$RELEASE_DIR")
  VERSION=$(awk '{print $2}' "$RELEASE_DIR/releases/start_erl.data" 2>/dev/null \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)

  if [ -z "$VERSION" ]; then
    echo "❌ Could not read release version"
    exit 1
  fi
  echo "Version: $VERSION"

  tar -czf "$RELEASE_NAME-$VERSION.tar.gz" -C _build/prod/rel "$RELEASE_DIR_NAME"/ || {
    echo "❌ Failed to create tarball"
    exit 1
  }
  echo "✓ Tarball created: $RELEASE_NAME-$VERSION.tar.gz"

  # The artifact must carry exactly one copy of the app. If it carries more, the
  # prune above stopped working and this release would ship every previous
  # version of the app inside it — fail before publishing, while the fix is one
  # command.
  COPIES=$(tar -tzf "$RELEASE_NAME-$VERSION.tar.gz" \
    | sed -n "s|^$RELEASE_DIR_NAME/lib/\($RELEASE_NAME-[0-9.]*\)/.*$|\1|p" \
    | sort -u | wc -l | tr -d ' ')
  if [ "$COPIES" != "1" ]; then
    echo "❌ the tarball carries $COPIES copies of $RELEASE_NAME — expected 1."
    echo "   Stale release dirs are back. Fix with:"
    echo "     scripts/prune_release_artifacts.sh --build-tree --apply"
    echo "   then re-run the push (nothing has been published)."
    exit 1
  fi
  echo "✓ Tarball carries exactly one copy of the app"

  if gh release view "v$VERSION" >/dev/null 2>&1; then
    gh release upload "v$VERSION" "$RELEASE_NAME-$VERSION.tar.gz" --clobber
  else
    gh release create "v$VERSION" "$RELEASE_NAME-$VERSION.tar.gz" \
      --title "Release v$VERSION" \
      --notes "Elixir LiveView surface $RELEASE_NAME v$VERSION" \
      --draft=false
  fi
  echo "✓ Release published to GitHub"

  # Published is the trigger for housekeeping: GitHub holds the durable artifact
  # now, so the local archives of past versions have no job left. Local only —
  # published releases are never touched. mix writes a second pile inside
  # _build/prod (see the `tar` step in mix.exs), so both are swept.
  echo ""
  echo "🧹 Pruning local release archives..."
  ./scripts/prune_release_artifacts.sh --archives --apply || \
    echo "⚠️  archive prune skipped — carrying on (old tarballs left behind)"

  echo ""
  echo "✅ All checks passed, release built and published!"
  echo "📤 Proceeding with push..."
else
  echo "ℹ️  Pushing to feature branch - skipping validation"
fi

echo ""
exit 0
